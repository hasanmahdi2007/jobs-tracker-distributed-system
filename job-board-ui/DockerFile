# ==========================================
# STAGE 1: BUILD (The Node.js Lifter)
# ==========================================
FROM node:18-alpine AS builder
WORKDIR /app

# Step 1: Copy ONLY package.json and package-lock.json first
COPY package*.json ./

# Step 2: Download dependencies (Docker caches this step!)
RUN npm install

# Step 3: Copy your actual React code (and the .env file)
COPY . .

# Step 4: Compile the Vite project into static HTML/JS files
RUN npm run build

# ==========================================
# STAGE 2: RUN (The Ultra-Lightweight Web Server)
# ==========================================
FROM nginx:alpine

# Step 5: Snatch the finished static files from the builder's 'dist' folder
COPY --from=builder /app/dist /usr/share/nginx/html

# Step 6: Expose standard web port
EXPOSE 80

# Step 7: Start Nginx to serve the website
CMD ["nginx", "-g", "daemon off;"]